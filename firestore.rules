rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================================
    // REGLAS DE DESARROLLO (Usar solo durante desarrollo)
    // ============================================================================

    // Descomentar esta sección para desarrollo rápido (INSEGURO para producción)
    /*
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    */

    // ============================================================================
    // REGLAS DE PRODUCCIÓN (Usar en producción)
    // ============================================================================

    // Reglas para colección de usuarios
    match /users/{userId} {
      // Permitir lectura y escritura solo del propio documento de usuario
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para colección de gastos
    match /gastos/{gastoId} {
      // Permitir lectura solo de gastos propios
      allow read: if request.auth != null &&
                     resource.data.userId == request.auth.uid;

      // Permitir creación solo si el userId coincide con el usuario autenticado
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;

      // Permitir actualización y eliminación solo de gastos propios
      allow update, delete: if request.auth != null &&
                               resource.data.userId == request.auth.uid;
    }

    // Reglas para colección de presupuestos
    match /presupuestos/{presupuestoId} {
      // Permitir lectura solo de presupuestos propios
      allow read: if request.auth != null &&
                     resource.data.userId == request.auth.uid;

      // Permitir creación solo si el userId coincide con el usuario autenticado
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;

      // Permitir actualización y eliminación solo de presupuestos propios
      allow update, delete: if request.auth != null &&
                               resource.data.userId == request.auth.uid;
    }
  }
}
