rules_version = '2';

// =============================================================================
// REGLAS FIRESTORE — versión consolidada (Fase 1 multi-cuenta)
// =============================================================================
//
// Reemplaza las reglas abiertas (`if request.auth != null`) que estaban en
// producción. Cada colección tiene reglas explícitas con principio de mínimo
// privilegio.
//
// ANTES de desplegar:
// 1. Probar en el simulador de Firebase Console (Reglas → Playground).
// 2. Probar contra el emulator local: firebase emulators:start --only firestore
// 3. Hacer login en la app desplegada y verificar que NADA se rompe.
// 4. Tener listo el rollback (las reglas viejas guardadas en algún lado).
//
// QUEDA PARA FUTURO:
// - `receipts` actualmente NO tiene campo `userId` → reglas permisivas.
//   Migrar para añadir `userId` y endurecer.
// - `currencies` y otros catálogos en `users/{uid}/...` están cubiertos
//   por la regla genérica `users/{uid}/{document=**}`.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPERS
    // ========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsResource() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsRequest() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/shared_groups/$(groupId)).data.members;
    }

    function isGroupCreator(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/shared_groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    // ========================================================================
    // USERS — perfil + todas las subcolecciones del usuario
    // (categories, paymentMethods, currencies, shortcuts, conversations,
    //  conversations/messages, profile, imports)
    // ========================================================================

    match /users/{userId} {
      // El propio user lee su doc; admins leen todos
      allow read: if isOwner(userId) || isAdmin();

      // Crear: solo el propio user. Puede autoasignarse 'standard' o
      // 'promocional' (trial PRO de usuario nuevo); NUNCA 'pro'/'admin'.
      // El vencimiento del trial lo valida el backend (Admin SDK), no las rules.
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) ||
          request.resource.data.role in ['standard', 'promocional']) &&
        (!('proRequestStatus' in request.resource.data) || request.resource.data.proRequestStatus == 'none');

      // Actualizar:
      //  - Caso A: el propio user, sin cambiar role y solo poniendo proRequestStatus a 'pending' o igual
      //  - Caso B: admin puede todo
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role ||
          // Auto-degradado del trial vencido: promocional → standard.
          // Solo "baja" — nunca permite escalar a pro/admin.
          (resource.data.role == 'promocional' &&
            request.resource.data.role == 'standard')
        ) &&
        (!('proRequestStatus' in request.resource.data) ||
          request.resource.data.proRequestStatus == resource.data.proRequestStatus ||
          request.resource.data.proRequestStatus == 'pending'
        )
      );

      // Borrar: solo admin (los users normales borran via backend que cascadea)
      allow delete: if isAdmin();

      // Subcolecciones del usuario (cualquier nivel de profundidad)
      // Cubre: profile, categories, paymentMethods, currencies, shortcuts,
      //        conversations, conversations/{cid}/messages, imports
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ========================================================================
    // EXPENSES — gastos top-level
    // ========================================================================

    match /expenses/{expenseId} {
      allow read: if ownsResource();
      allow create: if ownsRequest();
      allow update: if ownsResource() && ownsRequest();
      allow delete: if ownsResource();
    }

    // ========================================================================
    // PRESUPUESTOS
    // ========================================================================

    match /presupuestos/{presupuestoId} {
      allow read: if ownsResource();
      allow create: if ownsRequest();
      allow update: if ownsResource() && ownsRequest();
      allow delete: if ownsResource();
    }

    // ========================================================================
    // LEGACY: presupuestosEfectivo, movimientos, abonosEfectivo
    // ========================================================================
    // Eliminadas en Fase 6.7 (modelo Opción B).
    // Si quedan datos antiguos, el cleanup ocurre solo via backend al borrar
    // la cuenta del usuario (users.service.ts). El fallback al final niega
    // todo acceso desde clientes.

    // ========================================================================
    // RECEIPTS
    // ⚠️ TODO: añadir campo `userId` y endurecer. Por ahora solo auth required.
    // ========================================================================

    match /receipts/{receiptId} {
      allow read, write: if isSignedIn();
    }

    // ========================================================================
    // SHOPPING LISTS (poco uso — frontend usa localStorage; backend tiene CRUD)
    // ========================================================================

    match /shopping-lists/{listId} {
      allow read: if ownsResource();
      allow create: if ownsRequest();
      allow update: if ownsResource() && ownsRequest();
      allow delete: if ownsResource();
    }

    // ========================================================================
    // SHARED GROUPS — gastos compartidos
    // ========================================================================

    match /shared_groups/{groupId} {
      // Cualquier miembro lee el grupo
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      // Crear: el creador queda en members[] y como createdBy
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.members;

      // Actualizar: solo el creador (cambiar nombre, color, target, etc.)
      // El array members se modifica via backend (al aceptar invitación)
      allow update: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Borrar: solo el creador
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Subcolecciones: members, budgets, expenses, activity
      // Cualquier miembro del grupo lee y escribe (excepto borrar lo que no es suyo)
      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        allow write: if isGroupMember(groupId); // backend controla la lógica
      }

      match /budgets/{budgetId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        // Solo el aportante o el creador del grupo pueden modificar/borrar
        allow update, delete: if isGroupMember(groupId) && (
          resource.data.userId == request.auth.uid ||
          isGroupCreator(groupId)
        );
      }

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        allow update, delete: if isGroupMember(groupId) && (
          resource.data.userId == request.auth.uid ||
          isGroupCreator(groupId)
        );
      }

      match /activity/{activityId} {
        allow read: if isGroupMember(groupId);
        // Solo backend escribe activity logs (auditoría)
        allow write: if false;
      }
    }

    // ========================================================================
    // SHARED INVITATIONS — semi-públicas (alguien con el token puede preview)
    // ========================================================================

    match /shared_invitations/{invitationId} {
      // Lectura abierta a cualquier auth user (necesario para validar token al unirse)
      allow read: if isSignedIn();
      // Crear: el createdBy debe coincidir con el usuario
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      // Actualizar/borrar: solo el creador
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ========================================================================
    // ACCOUNTS — cuentas multi-cuenta del usuario (Fase 2)
    // ========================================================================

    match /accounts/{accountId} {
      allow read: if ownsResource();
      allow create: if ownsRequest();
      allow update: if ownsResource() && ownsRequest();
      allow delete: if ownsResource();
    }

    // ========================================================================
    // TRANSFERS — transferencias entre cuentas. Inmutables desde el cliente.
    // ========================================================================

    match /transfers/{transferId} {
      allow read: if ownsResource();
      allow create: if ownsRequest();
      // Inmutables: para corregir hay que delete + create
      allow update: if false;
      allow delete: if ownsResource();
    }

    // ========================================================================
    // CASH MOVEMENTS — retiros / depósitos dentro de una misma cuenta.
    // bankBalance ↔ cashBalance. Inmutables desde el cliente.
    // ========================================================================

    match /cash-movements/{movementId} {
      allow read: if ownsResource();
      allow create: if ownsRequest();
      allow update: if false;
      allow delete: if ownsResource();
    }

    // ========================================================================
    // GASTOS PROGRAMADOS — plantillas recurrentes que el cron del backend ejecuta.
    // El frontend solo LEE (onSnapshot). Las mutations pasan por el backend
    // (Admin SDK bypassa estas reglas). Esto evita que un cliente cree una
    // programación con próximaEjecucion manipulada o salte validaciones.
    // ========================================================================

    match /gastosProgramados/{programadoId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    // ========================================================================
    // TRANSFERENCIAS PROGRAMADAS — mismo principio que gastos: solo el backend
    // (Admin SDK) escribe. El cliente lee.
    // ========================================================================

    match /transferenciasProgramadas/{programadoId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    // ========================================================================
    // EJECUCIONES PROGRAMADAS — auditoría inmutable de cada disparo del cron.
    // Solo lectura para el dueño. Solo el backend escribe.
    // ========================================================================

    match /ejecucionesProgramadas/{ejecucionId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    // ========================================================================
    // NOTIFICACIONES — generadas por el cron (saldo insuficiente, fallos, etc.)
    // El cliente lee y puede marcar `leida` o borrarlas. NO puede crear ni
    // cambiar otros campos.
    // ========================================================================

    match /notificaciones/{notificacionId} {
      allow read: if ownsResource();
      // Solo el backend (Admin SDK) crea notificaciones.
      allow create: if false;
      // El cliente puede actualizar ÚNICAMENTE el campo `leida` (de false a true).
      // Cualquier otro cambio queda bloqueado para preservar la auditoría.
      allow update: if ownsResource() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      // El usuario puede borrar sus propias notificaciones (limpiar buzón).
      allow delete: if ownsResource();
    }

    // ========================================================================
    // AI USAGE — consumo de tokens IA (Fase 1: tracking).
    // Solo el backend / Cloud Functions (Admin SDK) escribe. El cliente
    // NUNCA escribe: el rollup alimenta la cuota (Fase 2) y un write del
    // dueño permitiría manipularla. Por eso vive top-level (no como
    // subcolección de users/, cuya regla recursiva daría write al dueño).
    // ========================================================================

    // Eventos de auditoría (1 por llamada IA). Solo admin lee.
    match /aiUsageEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Rollup mensual por usuario (doc id = `{uid}_{YYYY-MM}`, campo userId).
    // El dueño lee lo suyo; admin lee todo. Cliente nunca escribe.
    match /aiUsageMonthly/{docId} {
      allow read: if ownsResource() || isAdmin();
      allow write: if false;
    }

    // Rollup mensual del aplicativo (consumo autogenerado). Solo admin.
    match /aiUsageAppMonthly/{mes} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========================================================================
    // USAGE EVENTS — analítica de flujos / diagnóstico de producto.
    // Rollups de contadores escritos SOLO por el backend (Admin SDK). El
    // cliente nunca escribe: los eventos client van por POST /usage-events/track,
    // que el backend valida (allowlist) y agrega. El dueño lee su rollup
    // mensual; admin lee todo.
    // ========================================================================

    match /usageEventsAppMonthly/{mes} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /usageEventsAppDaily/{dia} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /usageEventsMonthly/{docId} {
      allow read: if ownsResource() || isAdmin();
      allow write: if false;
    }

    // ========================================================================
    // WHATSAPP QUEUE — solo Cloud Functions (Twilio webhook)
    // Ningún cliente debe leer ni escribir
    // ========================================================================

    match /whatsapp_queue/{queueId} {
      allow read, write: if false;
    }

    // ========================================================================
    // FALLBACK — denegar cualquier colección no contemplada arriba
    // ========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
