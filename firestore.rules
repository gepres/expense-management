rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================================
    // REGLAS DE DESARROLLO (Usar solo durante desarrollo)
    // ============================================================================

    // Descomentar esta sección para desarrollo rápido (INSEGURO para producción)
    /*
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    */

    // ============================================================================
    // REGLAS DE PRODUCCIÓN (Usar en producción)
    // ============================================================================

    // Reglas para colección de usuarios
    match /users/{userId} {
      // Permitir lectura si es el propio usuario o si es admin
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Permitir creación solo si el userId coincide con el usuario autenticado
      // y NO se está intentando asignar un rol distinto a 'standard' ni estado distinto a 'none'
      allow create: if request.auth != null && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'standard') &&
        (!('proRequestStatus' in request.resource.data) || request.resource.data.proRequestStatus == 'none');

      // Permitir actualización
      allow update: if request.auth != null && (
        // Caso 1: El usuario actualiza su propio perfil
        (request.auth.uid == userId && 
         // NO puede cambiar su rol
         (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
         // NO puede cambiar su estado de solicitud a 'approved' o 'rejected' (solo 'pending' o 'none')
         (!('proRequestStatus' in request.resource.data) || 
           request.resource.data.proRequestStatus == resource.data.proRequestStatus ||
           request.resource.data.proRequestStatus == 'pending'
         )
        ) ||
        // Caso 2: Un admin actualiza cualquier campo
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Reglas para colección de gastos
    match /gastos/{gastoId} {
      // Permitir lectura solo de gastos propios
      allow read: if request.auth != null &&
                     resource.data.userId == request.auth.uid;

      // Permitir creación solo si el userId coincide con el usuario autenticado
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;

      // Permitir actualización y eliminación solo de gastos propios
      allow update, delete: if request.auth != null &&
                               resource.data.userId == request.auth.uid;
    }

    // Reglas para colección de presupuestos
    match /presupuestos/{presupuestoId} {
      // Permitir lectura solo de presupuestos propios
      allow read: if request.auth != null &&
                     resource.data.userId == request.auth.uid;

      // Permitir creación solo si el userId coincide con el usuario autenticado
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;

      // Permitir actualización y eliminación solo de presupuestos propios
      allow update, delete: if request.auth != null &&
                               resource.data.userId == request.auth.uid;
    }
  }
}
