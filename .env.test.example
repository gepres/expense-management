# Variables de Entorno para Testing E2E con Playwright

# Credenciales de prueba (crear usuario de test en Firebase)
TEST_EMAIL=test@example.com
TEST_PASSWORD=testpassword123

# Firebase Configuration (mismas que en .env)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API
VITE_API_BASE_URL=http://localhost:3000/api

# Playwright Options (opcional)
PLAYWRIGHT_BROWSERS_PATH=0  # Usa caché global de navegadores
CI=false                     # Set a true en CI para habilitar reintentos
