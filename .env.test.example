# ============================================================================
# .env.test.example — copiar a .env.test para tests E2E (Playwright)
# ============================================================================
# Las pruebas E2E necesitan un proyecto Firebase de test (NO usar el de
# producción) y un usuario de prueba pre-creado.
# ============================================================================


# ============================================================================
# Credenciales de usuario de prueba
# ============================================================================
# Crear en Firebase Auth → Users → Add user.
# El password debe cumplir el mínimo de Firebase (6+ caracteres).
TEST_EMAIL=test@example.com
TEST_PASSWORD=Testpassword123


# ============================================================================
# Firebase (cliente) — usar credenciales de proyecto de TEST
# ============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ============================================================================
# Backend API
# ============================================================================
# Si los tests corren contra el backend local, dejar el default.
# Para CI: apuntar al backend desplegado en preview/staging.
VITE_API_BASE_URL=http://localhost:3000/api


# ============================================================================
# Aplicación
# ============================================================================
VITE_APP_ENV=test
VITE_APP_URL=http://localhost:5173


# ============================================================================
# AI Insights — desactivar cache para tests deterministas
# ============================================================================
# 0 minutos = sin cache. Cada llamada va al backend. Útil para asserts E2E.
VITE_AI_INSIGHTS_TTL_MINUTES=0


# ============================================================================
# Playwright
# ============================================================================
# 0 = usa cache global de Playwright (compartido entre proyectos).
# Vacío = descarga browsers locales en node_modules.
PLAYWRIGHT_BROWSERS_PATH=0

# CI=true habilita reintentos (2x) y screenshots/videos siempre.
# Local: dejar false para iteración rápida.
CI=false
