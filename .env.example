# ============================================================================
# Configuración de Firebase
# ============================================================================
# Obtén estas credenciales de tu proyecto Firebase
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# ============================================================================
# Configuración del Backend API
# ============================================================================
# URL base del backend que maneja el asistente IA y otras funcionalidades
# En desarrollo: http://localhost:3000/api
# En producción: https://tu-backend.com/api

VITE_API_BASE_URL=http://localhost:3000/api

# ============================================================================
# Configuración de la Aplicación
# ============================================================================

# Entorno de ejecución (development | production)
VITE_APP_ENV=development

# URL base de la aplicación (frontend)
VITE_APP_URL=http://localhost:5173

# ============================================================================
# Notas de Seguridad
# ============================================================================
# IMPORTANTE:
# 1. NUNCA subas el archivo .env al repositorio
# 2. Mantén tus API keys de Firebase seguras
# 3. En producción, usa variables de entorno del servidor
# 4. La API de Anthropic está en el backend (más seguro)
# 5. El backend valida el token de Firebase antes de procesar solicitudes
# 6. Considera usar Firebase App Check para mayor seguridad
