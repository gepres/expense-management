# ============================================================================
# .env.example — copiar a .env y rellenar valores reales
# ============================================================================
# NO subir el .env al repo. Mantener este .example sincronizado con todas las
# variables que el código usa (ver `import.meta.env.*` en src/).
# ============================================================================


# ============================================================================
# Firebase (cliente)
# ============================================================================
# Obtener desde: https://console.firebase.google.com/ → Settings → General
# Estas credenciales son SEGURAS de exponer al cliente: las reglas de
# Firestore + Auth controlan el acceso real.
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id


# ============================================================================
# Backend API (NestJS)
# ============================================================================
# URL base del backend. Maneja:
#   - Mutations atómicas (gastos, transferencias, cash-movements, presupuestos)
#   - Asistente IA (Claude vision + chat)
#   - Imports masivos (Excel, JSON)
#   - Bot WhatsApp (Twilio webhook)
#
# Desarrollo:  http://localhost:3000/api
# Producción:  https://tu-backend.com/api
VITE_API_BASE_URL=http://localhost:3000/api


# ============================================================================
# Aplicación
# ============================================================================
# Entorno: development | production. Cambia comportamiento de logs y PWA.
VITE_APP_ENV=development

# URL pública del frontend. Se usa para deep-links de WhatsApp e invitaciones.
VITE_APP_URL=http://localhost:5173


# ============================================================================
# WhatsApp Bot (Twilio)
# ============================================================================
# Número desde el que el bot envía mensajes. Formato: whatsapp:+codigo+numero.
# Sandbox de Twilio: whatsapp:+14155238886
VITE_TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Palabra clave del Sandbox de Twilio (Messaging → Try it out → WhatsApp
# Sandbox). El usuario debe enviar "join <keyword>" la primera vez. Si se
# deja vacío, la UI muestra una instrucción genérica.
VITE_TWILIO_SANDBOX_KEYWORD=


# ============================================================================
# AI Insights (Dashboard)
# ============================================================================
# Tiempo de cache (en minutos) para los tips IA del dashboard.
# Evita regenerar los insights con cada navegación. El usuario puede
# refrescar manualmente con el botón refresh. Default: 5 minutos.
VITE_AI_INSIGHTS_TTL_MINUTES=5


# ============================================================================
# Playwright (testing E2E, opcional)
# ============================================================================
# Path absoluto al cache de browsers de Playwright.
# Windows: C:\Users\<TU_USUARIO>\AppData\Local\ms-playwright
# Linux/Mac: ~/.cache/ms-playwright
PLAYWRIGHT_BROWSERS_PATH=

# Credenciales de un usuario de prueba en Firebase Auth.
# Usado por los tests E2E para autenticarse antes de cada suite.
TEST_EMAIL=test@example.com
TEST_PASSWORD=Testpassword123


# ============================================================================
# Notas de seguridad
# ============================================================================
# 1. NUNCA subas el .env al repo (está en .gitignore).
# 2. Las VITE_FIREBASE_* son seguras de exponer (el cliente las necesita).
#    La seguridad real está en las reglas de Firestore (firestore.rules).
# 3. La API de Anthropic NUNCA va al cliente. El backend la consume.
# 4. El backend valida el Firebase ID Token de cada request en su Guard.
# 5. Considera Firebase App Check en producción para frenar abuso del SDK.
